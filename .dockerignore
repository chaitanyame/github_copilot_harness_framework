# .dockerignore
# Exclude unnecessary files from Docker build context

# Git
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
*.egg
.eggs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentation
*.md
!README.md
docs/

# Environment and config
.env
.env.*
*.local

# Build artifacts
dist/
build/
*.spec

# Memory and specs (framework files)
memory/
specs/
templates/
scripts/bash/
scripts/powershell/

# Docker files (don't need to copy themselves)
Dockerfile
docker-compose.yml
.dockerignore

# Misc
*.log
*.tmp
.DS_Store
Thumbs.db
